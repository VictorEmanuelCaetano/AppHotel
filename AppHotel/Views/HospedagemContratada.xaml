<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppHotel.Views.HospedagemContratada"
             BackgroundColor="#F4EFE6"
             Title="Hospedagem Contratada">

    <VerticalStackLayout Padding="20" Spacing="10" VerticalOptions="Center">

        <Label Text="Hospedagem Contratada!"
               FontFamily="PoppinsBold"
               FontSize="28"
               TextColor="#1B3A4B"
               HorizontalOptions="Center" />

        <Label Text="Obrigado pela sua reserva!" HorizontalOptions="Center" />

        <Button Text="Voltar" BackgroundColor="#1B3A4B" Clicked="Button_Voltar_Clicked" />

    </VerticalStackLayout>
</ContentPage>
