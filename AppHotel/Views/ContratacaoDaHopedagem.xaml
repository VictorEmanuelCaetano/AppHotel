<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppHotel.Views.ContratacaoDaHopedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F4EFE6"
             Title="ContratacaoDaHopedagem">

    <VerticalStackLayout Padding="20" Spacing="10" VerticalOptions="Center">

        <Label Text="Cálculo da Diária"
               FontFamily="PoppinsBold"
               FontSize="32"
               TextColor="#1B3A4B"
               HorizontalOptions="Center" />

        <Label Text="Adultos:" />
        <Stepper x:Name="stp_adultos" Minimum="0" Maximum="10" />

        <Label Text="Crianças:" />
        <Stepper x:Name="stp_criancas" Minimum="0" Maximum="10" />

        <Label Text="Escolha sua Suíte:" />
        <Picker x:Name="pck_quarto" Title="Selecione">
            <Picker.Items>
                <x:String>Suíte Simples</x:String>
                <x:String>Suíte Luxo</x:String>
                <x:String>Suíte Presidencial</x:String>
            </Picker.Items>
        </Picker>

        <Label Text="Check-in:" />
        <DatePicker x:Name="dtpck_checkin" Format="dd/MM/yyyy" />

        <Label Text="Check-out:" />
        <DatePicker x:Name="dtpck_checkout" Format="dd/MM/yyyy" />

        <Button Text="Avançar" BackgroundColor="#1B3A4B" Clicked="Button_Avancar_Clicked" />
        <Button Text="Sobre" BackgroundColor="#C9A227" Clicked="Button_Sobre_Clicked" />

    </VerticalStackLayout>
</ContentPage>
